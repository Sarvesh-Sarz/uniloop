# ==============================================================================
# Uniloop Environment Configuration Template
# ==============================================================================

# Database Connection URL:
# For local zero-configuration SQLite development:
DATABASE_URL=sqlite:///./Uniloop.db

# For PostgreSQL (Production / Standard):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/campusshare_db

# JWT Secret Key and Expiration
SECRET_KEY=Uniloop_super_secret_jwt_key_for_development_replace_in_prod_2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# University Domain Restriction for Student Signups
UNIVERSITY_EMAIL_DOMAIN=@university.edu

# Default Daily Late Fee (in INR / standard platform currency)
DAILY_LATE_FEE=25.0

# Directory for local image uploads
UPLOAD_DIR=uploads

# Image storage
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=ap-south-1